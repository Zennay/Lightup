{
  "schema_version": 1,
  "purpose": "offline_tabletop_only",
  "default_containment": "open",
  "required_closure_fields": [
    "incident_id",
    "observed_at_utc",
    "tenant_id",
    "engagement_id",
    "run_id",
    "grant_id",
    "expected_version",
    "observed_version",
    "revoked_or_narrowed_dimensions",
    "queued_child_ids",
    "inflight_child_ids",
    "stop_requested_at",
    "stop_acknowledged_at",
    "terminal_state_by_child",
    "audit_receipt_refs",
    "reviewer_id",
    "review_at_utc",
    "closure_decision"
  ],
  "scenarios": [
    {"id": "revoked-before-dispatch", "expected": ["dispatch_denied", "retry_denied"]},
    {"id": "narrowed-after-approval", "expected": ["excluded_authority_denied", "resumption_requires_review"]},
    {"id": "expired-during-run", "expected": ["next_step_denied", "retry_denied", "child_terminal_state_verified"]},
    {"id": "resolver-audit-outage", "expected": ["dispatch_denied", "closure_denied"]},
    {"id": "cross-tenant-stale-run", "expected": ["foreign_grant_denied", "foreign_receipt_denied"]},
    {"id": "cancellation-ack-only", "expected": ["closure_denied", "terminal_state_unproven"]}
  ],
  "non_authority": true
}
