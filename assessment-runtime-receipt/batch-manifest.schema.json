{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LightUp offline batch receipt manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "sources"
  ],
  "properties": {
    "format": {
      "const": "lightup-offline-receipt-batch-v2"
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "expected_sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^/(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
          },
          "expected_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
