# Replace lightup.example.com and certificate paths before installation.
server {
    listen 443 ssl;
    server_name lightup.example.com;
    ssl_certificate /etc/letsencrypt/live/lightup.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lightup.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    client_header_timeout 10s;
    client_body_timeout 10s;
    send_timeout 30s;
    access_log off;

    location / {
        proxy_pass http://127.0.0.1:8766;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header Forwarded "";
        # Client-supplied method overrides are not trusted request methods.
        # Empty values make Nginx omit these headers from the upstream request.
        proxy_set_header X-HTTP-Method-Override "";
        proxy_set_header X-Method-Override "";
        proxy_set_header X-Original-Method "";
        proxy_set_header X-HTTP-Method "";
        proxy_set_header X-Forwarded-Ssl "";
        proxy_set_header X-Forwarded-Protocol "";
        proxy_request_buffering on;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 35s;
    }
}
